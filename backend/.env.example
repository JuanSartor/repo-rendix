DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.hfmuxlrmjmpryfexifdk.supabase.co:5432/postgres
PORT=8080

# Opcional: sin esta key, /api/rendimiento/real sigue funcionando pero solo con inflación ARG.
# Gratis en https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Opcional: sin estas dos, las alertas y el resumen diario se guardan pero no se
# envían por Telegram. Creá un bot con @BotFather en Telegram para obtener el token,
# y mandale un mensaje a tu bot + consultá https://api.telegram.org/bot<TOKEN>/getUpdates
# para encontrar tu chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Hora del día (0-23, hora del servidor) en que se manda el resumen diario. Default: 9.
RESUMEN_HORA=9

# Opcional: dominios adicionales permitidos por CORS (además de localhost:5173/3000
# que siempre están habilitados), separados por coma. Necesario en producción para
# el frontend deployado y la landing page.
ALLOWED_ORIGINS=
